BenchmarkStringSkip(&data) public {
	Set testString = ""
	For j=1:1:20 {
		Set testString = testString_",""["
		For i=1:1:240 {
			If $random(3) {
				Set testString = testString _ "," _ $random(99999999999)_"."_$random(99999999999)
			} Else {
				Set testString = testString _ ",NaN"
			}
		}
		Set testString = testString _ "]"", other, data, goes, 11, here, [NaN]"
	}
	$$$RunScenarios(100, testString)
}

/// Best min (best-case) / mean (average-case)
BenchmarkStringSkipFind(string) public {
	Set start = $zHorolog,
		stringIndex = 1
	For i=1:1:10 Set stringIndex = $find(string, "[")
	Quit $zHorolog - start
}

BenchmarkStringSkipExtract(string) public {
	Set start = $zHorolog,
		stringIndex = 1
	For i=1:1:10 {
		Do {
			Set stringIndex = stringIndex+1
		} While $extract(string, stringIndex) '= "["
	}
	Return $zHorolog - start
}

BenchmarkStringSkipVector(string) public {
	Set start = $zHorolog
	#; Not strictly skipping, but would serve the same purpose.
	Set vec = $vectorOp("fromstring", string, "string"),
		stringIndex = $vector(vec, 1),
		stringIndex = $vector(vec, 3),
		stringIndex = $vector(vec, 10)
	Return $zHorolog - start
}

/// Best max (worst-case)
BenchmarkStringSkipPiece(string) public {
	Set start = $zHorolog
	#; Not strictly skipping, but would serve the same purpose.
	Set stringIndex = $piece(string, "[", 1),
		stringIndex = $piece(string, "[", 3),
		stringIndex = $piece(string, "[", 10)
	Return $zHorolog - start
}

BenchmarkStringSkipList(string) public {
	Set start = $zHorolog
	#; Not strictly skipping, but would serve the same purpose.
	Set list = $listFromString(string,"["),
		stringIndex = $list(list, 1),
		stringIndex = $list(list, 3),
		stringIndex = $list(list, 10)
	Return $zHorolog - start
}

/// ----------------------------

BenchmarkMinMax(&data) public {
	Set testString = "["
	For i=1:1:2000 {
		If $random(3) {
			Set testString = testString _ "," _ $random(999999) _ "." _ $random(999999)
		} Else {
			Set testString = testString _ ",NaN"
		}
	}
	Set testString = testString _ "]"", other, data, goes, 11, here, [NaN]"
	$$$RunScenarios(10, testString)
}

BenchmarkMinMaxCustom(string) public {
	Set start = $zHorolog,
		(stringIndex2, fluxStringIndex) = 1,
		stringIndex = $find(string, "]", stringIndex2) + 1,
		fluxString = $extract(string, stringIndex2, stringIndex - 3),
		minIntLength = 999, 
		(maxIntLength, max, min) = 0,
		fluxStringWithTrailingComma = fluxString _ ","
	For {
		Set currentIntStartIndex = fluxStringIndex, 
			fluxStringIndex = $find(fluxString, ".", fluxStringIndex), 
			currentIntFirstDigit = $extract(fluxString, currentIntStartIndex)
		While currentIntFirstDigit = "N" {
			Set currentIntStartIndex = currentIntStartIndex + 4,
				currentIntFirstDigit = $extract(fluxString, currentIntStartIndex)
		}
		Quit:currentIntStartIndex>=fluxStringIndex
		Set currentIntLength = fluxStringIndex - 1 - currentIntStartIndex, 
			fluxStringIndex = $find(fluxStringWithTrailingComma, ",", fluxStringIndex)
		If currentIntLength > maxIntLength {
			Set max = $extract(fluxString, currentIntStartIndex, fluxStringIndex - 2),
				maxIntLength = currentIntLength,
				maxIntFirstDigit = currentIntFirstDigit
		} ElseIf currentIntLength < minIntLength {
			Set min = $extract(fluxString, currentIntStartIndex, fluxStringIndex - 2),
				minIntLength = currentIntLength,
				minIntFirstDigit = currentIntFirstDigit
		} Else {
			Set currentNumber = $extract(fluxString, currentIntStartIndex, fluxStringIndex - 2)
			If (currentIntLength = maxIntLength && (currentIntFirstDigit > maxIntFirstDigit || (currentIntFirstDigit = maxIntFirstDigit && (currentNumber > max)))) {
				Set max = currentNumber,
					maxIntFirstDigit = currentIntFirstDigit
			} Else {
				Set:(currentIntLength = minIntLength)&&(currentIntFirstDigit < minIntFirstDigit || (currentIntFirstDigit = minIntFirstDigit && (currentNumber < min))) min = currentNumber, 
					minIntFirstDigit = currentIntFirstDigit
			}
		}
		Quit:'fluxStringIndex
	}
	Return $zHorolog - start
}

/// Best
BenchmarkMinMaxVector(string) public {
	Set start = $zHorolog,
		stringIndex2 = 1,
		stringIndex = $find(string, """", stringIndex2),
		fluxVector = $vectorOp("fromstring", $extract(string, stringIndex2, stringIndex - 3), "decimal"),
		min = $vectorOp("min", fluxVector, $vectorOp("!=", fluxVector, 0)),
		max = $vectorOp("max", fluxVector)
	Return $zHorolog - start
}

BenchmarkMinMaxDynamicArray(string) public {
	Set start = $zHorolog
	Set stringIndex2=1
	Set stringIndex = $find(string, """", stringIndex2)
	Set dynamicArray = ##class(%DynamicArray).%FromJSON($replace($extract(string, stringIndex2, stringIndex - 2), "NaN", "0"))
	Set min = +dynamicArray."0",
		max = +dynamicArray."0",
		iterator = dynamicArray.%GetIterator()
	While iterator.%GetNext(, .val) {
		Set:val>max max=+val
		Set:val<min&&val min=+val
	}
	Return $zHorolog - start
}

/// ----------------------------

BenchmarkStringConcat(&data) public {
	$$$RunScenarios(100, .buffer)
}

/// Best
BenchmarkStringConcatDefault(&unused) public {
	Set input = "",
		$piece(input, "x", 500000) = "",
		start = $zHorolog
	Set output = input_input
	Return $zHorolog - start
}

BenchmarkStringConcatInPlace(&buffer) public {
	Set input="",
		$piece(input, "x", 500000)="",
		start = $zHorolog
	Set:'$data(buffer) buffer="",
		$piece(buffer, "z", 1000000)=""
	Set $extract(buffer,      1, 500000)=input,
		$extract(buffer, 500001,      *)=input
	Return $zHorolog - start
}

/// ----------------------------

BenchmarkToString(&data) public {
	Set string="123"
	For i=1:1:10000 Set string = string _ "," _ $random(112312541234)
	Set stringVector = $vectorOp("fromstring", string, "string"),
		decimalVector = $vectorOp("fromstring", string, "decimal")
	$$$RunScenarios(10, stringVector, decimalVector, decimalVector, decimalVector, decimalVector, decimalVector)
}

BenchmarkToStringVectorMaskEarly(sourceIdVector, bpFluxMinVector, bpFluxMaxVector, rpFluxMinVector, rpFluxMaxVector, fluxMaxPercentChangeVector) public {
	Set start = $zHorolog,
		mask = $vectorOp(">", fluxMaxPercentChangeVector, $$$minRequiredFluxPercentChange),
		out = $vectorOp("tostring", 
			$vectorOp("e_", 
				$vectorOp("v_",  $vectorOp("v_", $vectorOp("v_", $vectorOp("v_", $vectorOp("v_",
					$vectorOp("_",                                     sourceIdVector,                                    ",", mask),
					$vectorOp("_", $vectorOp("convert",                $vectorOp("mask",bpFluxMinVector,mask), "string"), ",")),
					$vectorOp("_", $vectorOp("convert",                $vectorOp("mask",bpFluxMaxVector,mask), "string"), ",")),
					$vectorOp("_", $vectorOp("convert",                $vectorOp("mask",rpFluxMinVector,mask), "string"), ",")),
					$vectorOp("_", $vectorOp("convert",                $vectorOp("mask",rpFluxMaxVector,mask), "string"), ",")),
					/*          */ $vectorOp("convert", $vectorOp("*", fluxMaxPercentChangeVector, 100, mask), "string")
				),$char(10)
			), ""
		)
	Return $zHorolog - start
}

BenchmarkToStringVectorMaskLate(sourceIdVector, bpFluxMinVector, bpFluxMaxVector, rpFluxMinVector, rpFluxMaxVector, fluxMaxPercentChangeVector) public {
	Set start = $zHorolog,
		out = $vectorOp("tostring", 
			$vectorOp("e_", 
				$vectorOp("mask", 
					$vectorOp("v_",  $vectorOp("v_", $vectorOp("v_", $vectorOp("v_", $vectorOp("v_",
						$vectorOp("_",                                     sourceIdVector,                              ","),
						$vectorOp("_", $vectorOp("convert",                bpFluxMinVector,                  "string"), ",")),
						$vectorOp("_", $vectorOp("convert",                bpFluxMaxVector,                  "string"), ",")),
						$vectorOp("_", $vectorOp("convert",                rpFluxMinVector,                  "string"), ",")),
						$vectorOp("_", $vectorOp("convert",                rpFluxMaxVector,                  "string"), ",")),
						/*          */ $vectorOp("convert", $vectorOp("*", fluxMaxPercentChangeVector, 100), "string")
					), 
					$vectorOp(">", fluxMaxPercentChangeVector, $$$minRequiredFluxPercentChange)
				), $char(10)
			), ""
		)
	Return $zHorolog - start
}

/// Best
BenchmarkToStringLoop(sourceIdVector, bpFluxMinVector, bpFluxMaxVector, rpFluxMinVector, rpFluxMaxVector, fluxMaxPercentChangeVector) public {
	Set dataRow = $vectorOp("length",sourceIdVector),
		start = $zHorolog
	For i=1:1:dataRow {
		Set percentChange = $vector(fluxMaxPercentChangeVector, i)
		Set:percentChange>$$$minRequiredFluxPercentChange out = $c(10) _ $vector(sourceIdVector, i) _ "," _ $vector(bpFluxMinVector, i) _ "," _ $vector(bpFluxMaxVector, i) _ "," _ $vector(rpFluxMinVector, i) _ "," _ $vector(rpFluxMaxVector, i) _ "," _ (percentChange * 100)
	}
	Return $zHorolog - start
}

/// ----------------------------

BenchmarkWrite(&data) public {
	$$$RunScenarios(1000)
}

/// Best
BenchmarkWriteConcat(x=1, y=2, z="test") public {
	Set start = $zHorolog, 
		oldIO = $IO
	Open "/dev/null"
	Use "/dev/null"
	For i=1:1:1000 Write "a" _ x _ "bldf" _ y _ "yw45srt" _ z _ $char(10)
	Set ret = $zHorolog - start
	Close "/dev/null"
	Use oldIO
	Return ret
}

BenchmarkWriteMultiple(x=1, y=2, z="test") public {
	Set start = $zHorolog, 
		oldIO = $IO
	Open "/dev/null"
	Use "/dev/null"
	For i=1:1:1000 Write "a", x, "bldf", y, "yw45srt", z, $c(10)
	Set ret = $zHorolog - start
	Close "/dev/null" Use oldIO
	Return ret
}

/// --------------------------

BenchmarkMaxPercent(&data) public {
	$$$RunScenarios(25, 30000)
}

/// Best (typically beats Hybrid by a _small_ amount)
BenchmarkMaxPercentVector(length) public {
	For i=1:1:length {
		Set $vector(bpFluxMaxVector,i,"decimal") = +($random(12351239874) _ "." _ $random(12351239874)),
			$vector(bpFluxMinVector,i,"decimal") = +($random(12351239874) _ "." _ $random(12351239874)),
			$vector(rpFluxMaxVector,i,"decimal") = +($random(12351239874) _ "." _ $random(12351239874)),
			$vector(rpFluxMinVector,i,"decimal") = +($random(12351239874) _ "." _ $random(12351239874))
	}
	Set start = $zHorolog,
		bpFluxPercentChangeVector = $vectorOp("v/", $vectorOp("v-", bpFluxMaxVector, bpFluxMinVector), bpFluxMinVector, $vectorOp("!=", bpFluxMinVector, 0)),
		rpFluxPercentChangeVector = $vectorOp("v/", $vectorOp("v-", rpFluxMaxVector, rpFluxMinVector), rpFluxMinVector, $vectorOp("!=", rpFluxMinVector, 0)),
		fluxMaxPercentChangeVector = $vectorOp("vset", bpFluxPercentChangeVector, rpFluxPercentChangeVector, $vectorOp("v<", bpFluxPercentChangeVector, rpFluxPercentChangeVector))
	Return $zHorolog - start
}

BenchmarkMaxPercentLoop(length) public {
	For i=1:1:length {
		Set bpFluxMax(i) = +($random(12351239874) _ "." _ $random(12351239874)),
			bpFluxMin(i) = +($random(12351239874) _ "." _ $random(12351239874)),
			rpFluxMax(i) = +($random(12351239874) _ "." _ $random(12351239874)),
			rpFluxMin(i) = +($random(12351239874) _ "." _ $random(12351239874))
	}
	Set start = $zHorolog
	For i=1:1:length {
		If bpFluxMin(i) {
			Set maxPercentChange = bpFluxMax(i) - bpFluxMin(i) / bpFluxMin(i)
			If rpFluxMin(i) {
				Set tmp = rpFluxMax(i) - rpFluxMin(i) / rpFluxMin(i)
				Set:tmp>maxPercentChange maxPercentChange = tmp
			}
		} ElseIf rpFluxMin(i) {
			Set maxPercentChange = rpFluxMax(i) - rpFluxMin(i) / rpFluxMin(i)
		}
	}
	Return $zHorolog - start
}

BenchmarkMaxPercentHybrid(length) public {
	For i=1:1:length {
		Set $vector(bpFluxMaxVector,i,"decimal") = +($random(12351239874) _ "." _ $random(12351239874)),
			$vector(bpFluxMinVector,i,"decimal") = +($random(12351239874) _ "." _ $random(12351239874)),
			$vector(rpFluxMaxVector,i,"decimal") = +($random(12351239874) _ "." _ $random(12351239874)),
			$vector(rpFluxMinVector,i,"decimal") = +($random(12351239874) _ "." _ $random(12351239874))
	}
	Set start = $zHorolog,
		bpFluxPercentChangeVector = $vectorOp("v/", $vectorOp("v-", bpFluxMaxVector, bpFluxMinVector), bpFluxMinVector, $vectorOp("!=", bpFluxMinVector, 0)),
		rpFluxPercentChangeVector = $vectorOp("v/", $vectorOp("v-", rpFluxMaxVector, rpFluxMinVector), rpFluxMinVector, $vectorOp("!=", rpFluxMinVector, 0))
	For i=1:1:length {
		Set fluxMaxPercentChange = $vector(bpFluxPercentChangeVector, i),
			rpFluxPercentChange = $vector(rpFluxPercentChangeVector, i)
		Set:rpFluxPercentChange>fluxMaxPercentChange fluxMaxPercentChange = rpFluxPercentChange
	}
	Return $zHorolog - start
}

#EndIf