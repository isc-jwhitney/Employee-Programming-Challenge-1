ROUTINE RunScript

#; Set to 0 to include file extration in the reported "elapsed time".
#Define PreExtractFiles 1

#; We will run this routine to do the benchmark
Run()
{
	#; extract files if necessary from .data/in to .data/temp
	#If $$$PreExtractFiles
		Set files = $listBuild(
			"EpochPhotometry_000000-003111",
			"EpochPhotometry_003112-005263",
			"EpochPhotometry_005264-006601",
			"EpochPhotometry_006602-007952",
			"EpochPhotometry_007953-010234",
			"EpochPhotometry_010235-012597",
			"EpochPhotometry_012598-014045",
			"EpochPhotometry_014046-015369",
			"EpochPhotometry_015370-016240",
			"EpochPhotometry_016241-017018",
			"EpochPhotometry_017019-017658",
			"EpochPhotometry_017659-018028",
			"EpochPhotometry_018029-018472",
			"EpochPhotometry_018473-019161",
			"EpochPhotometry_019162-019657",
			"EpochPhotometry_019658-020091",
			"EpochPhotometry_020092-020493",
			"EpochPhotometry_020494-020747",
			"EpochPhotometry_020748-020984",
			"EpochPhotometry_020985-021233"
		)
		Do ##class(%File).CreateDirectory("/home/irisowner/dev/data/temp")
		For i=1:1:$listLength(files) {
			Set compressedStream = ##class(%Stream.FileBinaryGzip).%New(),
				extractedStream = ##class(%Stream.FileBinary).%New()
			Do compressedStream.LinkToFile("/home/irisowner/dev/data/in/" _ $list(files, i) _ ".csv.gz"),
				extractedStream.LinkToFile("/home/irisowner/dev/data/temp/" _ $list(files, i) _ ".csv"),
				extractedStream.CopyFrom(compressedStream),
				compressedStream.%Close(),
				extractedStream.%Save()
		}
	#EndIf

	#; Start time
	Set startTime = $zHorolog
		
	Set files = $listBuild(
		"EpochPhotometry_000000-003111",
		"EpochPhotometry_003112-005263",
		"EpochPhotometry_005264-006601",
		"EpochPhotometry_006602-007952",
		"EpochPhotometry_007953-010234",
		"EpochPhotometry_010235-012597",
		"EpochPhotometry_012598-014045",
		"EpochPhotometry_014046-015369",
		"EpochPhotometry_015370-016240",
		"EpochPhotometry_016241-017018",
		"EpochPhotometry_017019-017658",
		"EpochPhotometry_017659-018028",
		"EpochPhotometry_018029-018472",
		"EpochPhotometry_018473-019161",
		"EpochPhotometry_019162-019657",
		"EpochPhotometry_019658-020091",
		"EpochPhotometry_020092-020493",
		"EpochPhotometry_020494-020747",
		"EpochPhotometry_020748-020984",
		"EpochPhotometry_020985-021233"
	)
	Do ##class(%File).CreateDirectory("/home/irisowner/dev/data/out")

	#; Process spawning overhead is a problem, so use existing jobs via the WQM.
	Set defaultWorkQueue = $System.WorkMgr.%New(), 
		defaultWorkQueueNumWorkers = defaultWorkQueue.NumberWorkers()
	If $listLength(files) <= defaultWorkQueueNumWorkers {
		For i=1:1:$listLength(files) Do defaultWorkQueue.Queue("RunOnFile^RunScript", $listGet(files,i), $pid)
	} Else {
		#; There aren't enough jobs in the general pool to process all files concurrently: Use the SQL pool as well.
		For i=1:1:defaultWorkQueueNumWorkers Do defaultWorkQueue.Queue("RunOnFile^RunScript", $listGet(files,i), $pid)
		Set sqlWorkQueue = $System.WorkMgr.%New(,,"SQL")
		For i=defaultWorkQueueNumWorkers+1:1:$listLength(files) Do sqlWorkQueue.Queue("RunOnFile^RunScript", $listGet(files,i), $pid)
	}
	For i=1:1:$listLength(files) Do $System.Event.WaitMsg()

	#; End time
	Set endTime = $zHorolog
	#; Elapsed time in seconds
	Set elapsed = endTime - startTime
	Write "Elapsed time: ", elapsed, " seconds", !
}

RunOnFile(file, waitingPid) public
{
	#; Min required change to be included in output (1 = 100%)
	#define minRequiredFluxPercentChange 1

	#; Value >= max-line-length-in-input-files
	#define maxLineLength (2**16)

	#; Value >= maxLineLength
	#define readLength (2**16)

	#; Write code to flush device output
	#define flushOutput *-3
	
	#; Initial read
	#If $$$PreExtractFiles
		Set inputFile = "/home/irisowner/dev/data/temp/" _ file _ ".csv", 
			outputFile = "/home/irisowner/dev/data/out/"_file_".csv" 
		Open inputFile:(/UNDEFINED:/NOXY:/READ),
			outputFile:(/UNDEFINED:/NOXY:/WRITE:/TRUNCATE:/APPEND:/OBUFSIZE=(2**16))
	#Else
		Set inputFile = "/home/irisowner/dev/data/in/" _ file _ ".csv.gz", 
			outputFile = "/home/irisowner/dev/data/out/"_file_".csv" 
		Open inputFile:(/UNDEFINED:/NOXY:/READ:/GZIP),
			outputFile:(/UNDEFINED:/NOXY:/WRITE:/TRUNCATE:/APPEND:/OBUFSIZE=(2**16))
	#EndIf

	Use inputFile
	Read string#$$$readLength 
	Set stringMaxIndexForAGuaranteedFullLine = $length(string) - $$$maxLineLength, 
		(stringIndex, dataRow) = 1
	
	#; Skip lines starting with "#"
	Do { 
		Set stringIndex = $find(string, $char(10), stringIndex) 
	} While $extract(string, stringIndex) = "#" 

	#; Use $zEOF for future reads
	Do $System.Process.SetZEOF(1)
	
	For {
		#; Read more data, if we might not have a full line to process
		If stringIndex > stringMaxIndexForAGuaranteedFullLine {
			Read newString#$$$readLength 
			Set:'$zEOF string = $extract(string, stringIndex, *) _ newString, 
				stringMaxIndexForAGuaranteedFullLine = $length(string) - $$$maxLineLength,
				stringIndex = 1
					
			#; Skip to source_id in the next line
			Set stringIndex2 = $find(string, ",", $find(string, $char(10), stringIndex))

			#; If the read failed (EOF) and there are no more lines to process, exit the loop
			Quit:$zEOF&&'stringIndex2

		} Else {
			#; Skip to source_id in the next line
			Set stringIndex2 = $find(string, ",", $find(string, $char(10), stringIndex))
		}

		#; Add source_id to sourceIdLocalArray
		Set stringIndex = $find(string, ",", stringIndex2), 
			sourceIdLocalArray(dataRow) = $extract(string, stringIndex2, stringIndex - ##Expression($length(",") + 1)),
		
			#; Skip to bp_flux
			stringIndex2 = $find(string, "[", $find(string, "[", $find(string, "[", $find(string, "[", $find(string, "[", $find(string, "[", $find(string, "[", $find(string, "[", $find(string, "[", stringIndex))))))))),

			#; Add min, max bp_flux values to bpFluxMinVector, bpFluxMaxVector
			#;  fromstring/decimal turns NaN into 0
			stringIndex = $find(string, """", stringIndex2),
			fluxVector = $vectorOp("fromstring", $extract(string, stringIndex2, stringIndex - ##Expression($length("]""") + 1)), "decimal"),
			$vector(bpFluxMinVector, dataRow, "decimal") = $vectorOp("min", fluxVector, $vectorOp("!=", fluxVector, 0)),
			$vector(bpFluxMaxVector, dataRow, "decimal") = $vectorOp("max", fluxVector),

			#; Skip to rp_flux
			stringIndex2 = $find(string, "[", $find(string, "[", $find(string, "[", $find(string, "[", $find(string, "[", stringIndex))))),

			#; Add min, max rp_flux values to rpFluxMinVector, rpFluxMaxVector
			stringIndex = $find(string, """", stringIndex2),
			fluxVector = $vectorOp("fromstring", $extract(string, stringIndex2, stringIndex - ##Expression($length("]""") + 1)), "decimal"),
			$vector(rpFluxMinVector, dataRow, "decimal") = $vectorOp("min", fluxVector, $vectorOp("!=", fluxVector, 0)),
			$vector(rpFluxMaxVector, dataRow, "decimal") = $vectorOp("max", fluxVector),

			#; Increment line number
			dataRow = dataRow + 1
	}

	#; Calculate % change for bp_flux and rp_flux
	Set bpFluxPercentChangeVector = $vectorOp("v/", $vectorOp("v-", bpFluxMaxVector, bpFluxMinVector), bpFluxMinVector, $vectorOp("!=", bpFluxMinVector, 0)),
		rpFluxPercentChangeVector = $vectorOp("v/", $vectorOp("v-", rpFluxMaxVector, rpFluxMinVector), rpFluxMinVector, $vectorOp("!=", rpFluxMinVector, 0)),

		#; Calculate max % change between bp_flux and rp_flux
		fluxMaxPercentChangeVector = $vectorOp("vset", bpFluxPercentChangeVector, rpFluxPercentChangeVector, $vectorOp("v<", bpFluxPercentChangeVector, rpFluxPercentChangeVector))

	#; Write header
	Use outputFile
	Write "source_id,bp_min_flux,bp_max_flux,rp_min_flux,rp_max_flux,percentage_change"

	#; Write data
	For i=1:1:dataRow-1 {
		Set fluxMaxPercentChange = $vector(fluxMaxPercentChangeVector, i)
		Write:fluxMaxPercentChange>$$$minRequiredFluxPercentChange $char(10) _ sourceIdLocalArray(i) _ "," _ $vector(bpFluxMinVector, i) _ "," _ $vector(bpFluxMaxVector, i) _ "," _ $vector(rpFluxMinVector, i) _ "," _ $vector(rpFluxMaxVector, i) _ "," _ (fluxMaxPercentChange*100)
	}
	Write $$$flushOutput
	
	#; Notify parent process that output has been fully written
	Do $System.Event.Signal(waitingPid)

	#; Cleanup
	Close inputFile, outputFile
}

#; For testing
Reload
	zw $System.OBJ.Load("/home/irisowner/dev/src/RunScript.mac","ck")
	q

#; Here down is timing bencharks for pieces of different approaches.
#If 1

#define GetLocation /* Get the current routine/tag into `thisRoutine` / `thisTag`. There's almost definitely a better way to do this. */ ##continue
	Try {                                                                                                                                ##continue
		ZTrap ""                                                                                                                         ##continue
	} Catch ex {                                                                                                                         ##continue
		Set thisTag = $piece(ex.Location, "+"),                                                                                          ##continue
			thisRoutine = $piece(ex.Location, "^", 2)                                                                                    ##continue
	}

#define ForTag /* Iterate over tags in the current routine in `tag`. Also sets `thisRoutine` / `thisTag` via $$$GetLocation. */  ##continue
	/* There is a way to do this using $zu functions without parsing int code, but it's messier. */                              ##continue
	$$$GetLocation                                                                                                               ##continue
	Set routine = ##class(%Routine).%OpenId(thisRoutine), matcher = ##class(%Regex.Matcher).%New("^([a-zA-Z%][a-zA-Z0-9%]*).*")  ##continue
	While 'routine.AtEnd {                                                                                                       ##continue
		Continue:'matcher.Match(routine.ReadLine())                                                                              ##continue
		Set tag = matcher.Group(1)

/// Run all benchmarks (any tag with the name Benchmark<X> is a benchmark implemented by "scenario" tags of the form Benchmark<X><Y>)
Benchmark(&data) public {
	set output = '$data(data)
	$$$ForTag
		Set:(tag '= thisTag)&&($extract(tag, 1, ##expression($length("Benchmark"))) = "Benchmark") benchmarkTags(tag)=""
	}
	Set benchmarkOrScenarioTag=""
	For {
		Set benchmarkOrScenarioTag = $order(benchmarkTags(benchmarkOrScenarioTag))
		Quit:benchmarkOrScenarioTag=""

		#; If this tag starts with the last benchmark tag, it's a scenario.
		Continue:$data(benchmarkTag)&&($extract(benchmarkOrScenarioTag,1,$length(benchmarkTag))=benchmarkTag)
		Set benchmarkTag = benchmarkOrScenarioTag

		Write:output benchmarkTag,!
		Set:'output tagData = 0
		Do @(benchmarkTag)(.tagData)
		Merge data = tagData
		Write:output !
	}
}

/// Convert benchmark data to CSV format
BenchmarkDataToCSV(&data) public {
	Set benchmarkMethod = "",
		columnNumber = 1
	For { 
		Set benchmarkMethod = $order(data(benchmarkMethod)) 
		Quit:benchmarkMethod=""
		Set $list(line(1), columnNumber) = benchmarkMethod
		Set scenario = ""
		For {
			Set scenario = $order(data(benchmarkMethod, scenario))
			Quit:scenario=""
			For i=1:1:data(benchmarkMethod, scenario) Set $list(line(i+2), columnNumber) = data(benchmarkMethod, scenario, i)
			Set $list(line(2), columnNumber) = scenario,
				columnNumber = columnNumber+1
		}
	}
	Set rowNumber = ""
	For {
		Set rowNumber = $Order(line(rowNumber))
		Quit:rowNumber=""
		Write $listToString(line(rowNumber),, 1), !
	}
}

#def1arg RunScenarios(%numIterationsThenArgs) /* Run this benchmark tag's scenarios with the given # of iterations / args. */                                                                                                                             ##continue
	Set output = '$data(data)                                                                                                                                                                                                                             ##continue
	$$$ForTag                                                                                                                                                                                                                                             ##continue
		Continue:tag=thisTag||($extract(tag, 1, $length(thisTag)) '= thisTag)                                                                                                                                                                             ##continue
		Set scenarioName = $extract(tag, $length(thisTag) + 1, *)                                                                                                                                                                                         ##continue
		Write:output "- " _ scenarioName                                                                                                                                                                                                                  ##continue
		For i=1:1:##Expression($p("%numIterationsThenArgs",",")) {                                                                                                                                                                                        ##continue
			Write:output&&'(i#(##Expression($select($piece("%numIterationsThenArgs", ",") <= 10: 1, 1: $piece("%numIterationsThenArgs", ",") / 10)))) "."                                                                                                 ##continue
			Set data(thisTag, scenarioName, $increment(data(thisTag, scenarioName))) = $$@(tag)(##Expression($piece("%numIterationsThenArgs", ",", 2, *)))                                                                                                ##continue
			Set:'$data(data(thisTag, scenarioName, "min"))||(data(thisTag, scenarioName, "min") > data(thisTag, scenarioName, data(thisTag, scenarioName))) data(thisTag, scenarioName, "min") = data(thisTag, scenarioName, data(thisTag, scenarioName)) ##continue
			Set:'$data(data(thisTag, scenarioName, "max"))||(data(thisTag, scenarioName, "max") < data(thisTag, scenarioName, data(thisTag, scenarioName))) data(thisTag, scenarioName, "max") = data(thisTag, scenarioName, data(thisTag, scenarioName)) ##continue
			Set data(thisTag, scenarioName, "mean") = $get(data(thisTag, scenarioName, "mean")) + data(thisTag, scenarioName, data(thisTag, scenarioName))                                                                                                ##continue
		}                                                                                                                                                                                                                                                 ##continue
		Set data(thisTag, scenarioName, "mean") = data(thisTag, scenarioName, "mean") / data(thisTag, scenarioName)                                                                                                                                       ##continue
		Write:output !, "  - min:  " _ $fnumber(data(thisTag, scenarioName, "min"), "", 6), !, "  - mean: " _ $fnumber(data(thisTag, scenarioName, "mean"), "", 6), !, "  - max:  " _ $fnumber(data(thisTag, scenarioName, "max"), "", 6), !              ##continue
	}

/// ----------------------------

/// Meant to benchmark startup time / max # of processes only. Does not check realistic workloads!
BenchmarkParallel(&data) public {
	$$$RunScenarios(3, 20)
}

/// Jobbing is way slower than the WQM, even when it's using Job Servers. Why?
BenchmarkParallelJobGlobal(numJobs) public {
	Set start = $zHorolog,
		^sync = numJobs
	For i=1:1:numJobs Job TestMethodHangSyncGlobal
	While ^sync { Hang 0.01 }
	Return $zHorolog-start
}

BenchmarkParallelJobEvent(numJobs) public {
	Set start = $zHorolog
	For i=1:1:numJobs Job TestMethodHangSyncEvent($pid)
	For i=1:1:numJobs Do $System.Event.Wait()
	Return $zHorolog-start
}

BenchmarkParallelWQM(numJobs) public {
	Set start = $zHorolog,
		queue = $System.WorkMgr.%New()
	For i=1:1:numJobs Do queue.Queue("TestMethodHang")
	Do queue.Sync()
	Return $zHorolog - start
}

/// Best (tie?). Worse in the real use-case.
BenchmarkParallelWQMBorrow(numJobs) public {
	Set start = $zHorolog,
		sqlQueue = $System.WorkMgr.%New(,,"SQL"), 
		sqlQueueNumWorkers = sqlQueue.NumberWorkers()
	If numJobs <= sqlQueueNumWorkers {
		For i=1:1:numJobs Do sqlQueue.Queue("TestMethodHang")
		Do sqlQueue.Sync()
	} Else {
		For i=1:1:sqlQueueNumWorkers Do sqlQueue.Queue("TestMethodHang")
		Set defaultQueue = $System.WorkMgr.%New()
		For i=1:1:numJobs-sqlQueueNumWorkers Do defaultQueue.Queue("TestMethodHang")
		Do defaultQueue.Sync(), 
			sqlQueue.Sync()
	}
	Return $zHorolog - start
}

/// Best (tie?). Better in the real use-case.
/// Children can tell their parent they're "done" without needing to wait on destructors etc.
BenchmarkParallelWQMBorrowEvent(numJobs) public {
	Set start = $zHorolog,
		sqlQueue = $System.WorkMgr.%New(,,"SQL"), 
		sqlQueueNumWorkers = sqlQueue.NumberWorkers()
	If numJobs <= sqlQueueNumWorkers {
		For i=1:1:numJobs Do sqlQueue.Queue("TestMethodHangSyncEvent",$pid)
	} Else {
		For i=1:1:sqlQueueNumWorkers Do sqlQueue.Queue("TestMethodHangSyncEvent",$pid)
		Set defaultQueue = $System.WorkMgr.%New()
		For i=1:1:numJobs-sqlQueueNumWorkers Do defaultQueue.Queue("TestMethodHangSyncEvent",$pid)
	}
	For i=1:1:numJobs Do $System.Event.Wait()
	Return $zHorolog - start
}

BenchmarkParallelHybrid(numJobs) public {
	Set start = $zHorolog,
		queue = $System.WorkMgr.%New(), 
		queueNumWorkers = queue.NumberWorkers()
	If numJobs <= queueNumWorkers {
		For i=1:1:numJobs Do queueNumWorkers.Queue("TestMethodHang")
	} Else {
		For i=1:1:queueNumWorkers Do queue.Queue("TestMethodHang")
		For i=1:1:numJobs-queueNumWorkers Job TestMethodHangSyncEvent($pid)
		For i=1:1:numJobs-queueNumWorkers Do $System.Event.Wait()
	}
	Do queue.Sync()
	Return $zHorolog - start
}

TestMethodHang() public {
	Hang 1
}

TestMethodHangSyncGlobal() public {
	Hang 1
	Do $increment(^sync, -1)
}

TestMethodHangSyncEvent(pid) public {
	Hang 1
	Do $System.Event.Signal(pid)
}

